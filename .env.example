# Local development template. Replace these placeholders before configuring a shared environment.
NERVA_ENVIRONMENT=LOCAL
NERVA_EXECUTION_ENABLED=false
NERVA_KILL_SWITCH_ENABLED=true
NERVA_DEMO_SIMULATION_ENABLED=false
NERVA_LOG_LEVEL=info
DATABASE_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/replace-me
POSTGRES_DB=replace-me
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
