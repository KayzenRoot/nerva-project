# Local development template. Replace these placeholders before configuring a shared environment.
NERVA_ENVIRONMENT=LOCAL
NERVA_EXECUTION_ENABLED=false
NERVA_KILL_SWITCH_ENABLED=true
NERVA_DEMO_SIMULATION_ENABLED=false
NERVA_LOG_LEVEL=info
PERPL_OBSERVATION_ENABLED=false
PERPL_CHAIN_ID=143
PERPL_API_URL=https://app.perpl.xyz/api
PERPL_WS_URL=wss://app.perpl.xyz
PERPL_MARKET_FRESHNESS_MS=5000
PERPL_ACCOUNT_FRESHNESS_MS=15000
PERPL_RECONNECT_MIN_MS=250
PERPL_RECONNECT_MAX_MS=30000
# Optional authenticated account observation: provide all three server-side values together.
# PERPL_API_KEY=read-only-key
# PERPL_API_KEY_SECRET=read-only-ed25519-api-secret-hex
# PERPL_API_KEY_SCOPE=read
DATABASE_URL=postgresql://replace-me:replace-me@127.0.0.1:5432/replace-me
POSTGRES_DB=replace-me
POSTGRES_USER=replace-me
POSTGRES_PASSWORD=replace-me
