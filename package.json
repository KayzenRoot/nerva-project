{
  "name": "nerva-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NERVA observation and deterministic risk platform",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/worker",
    "packages/domain",
    "packages/contracts",
    "packages/config",
    "packages/observability",
    "packages/db",
    "packages/testing",
    "packages/perpl",
    "packages/risk",
    "packages/policy",
    "packages/execution",
    "packages/permissions"
  ],
  "scripts": {
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"*.{json,ts,mjs}\" \"eslint.config.mjs\" \"vitest.config.ts\" \".github/scripts/*.{mjs,ts}\" \".github/workflows/*.yml\" \"docs/*.md\" \"README.md\" \"compose.yaml\" \".engineering/evidence/NERVA-WO-003-EVIDENCE.md\" \".engineering/checkpoint-deltas/NERVA-WO-003-PROPOSED.md\" \".engineering/work-orders/NERVA-WO-004.md\" \".engineering/context-locks/NERVA-WO-004.json\" \".engineering/execution-briefs/NERVA-WO-004-CODEX.md\" \".engineering/evidence/NERVA-WO-004-EVIDENCE.md\" \".engineering/work-orders/NERVA-WO-005.md\" \".engineering/context-locks/NERVA-WO-005.json\" \".engineering/execution-briefs/NERVA-WO-005-CODEX.md\" \".engineering/evidence/NERVA-WO-005-EVIDENCE.md\" \".engineering/context-locks/NERVA-WO-006.json\" \".engineering/execution-briefs/NERVA-WO-006-CODEX.md\" \".engineering/evidence/NERVA-WO-006-EVIDENCE.md\"",
    "build": "npm run build --workspace=@nerva/web && npm run build --workspace=@nerva/worker",
    "dev:web": "npm run dev --workspace=@nerva/web",
    "worker:start": "node --experimental-strip-types apps/worker/src/main.ts",
    "workspace:validate": "node .github/scripts/validate-workspaces.mjs",
    "deps:boundary": "node .github/scripts/check-no-forbidden-deps.mjs",
    "m03:safety:verify": "node .github/scripts/verify-m03-safety.mjs",
    "context:validate": "node .github/scripts/validate-m05-admission.mjs && node .github/scripts/validate-nerva-context-lock.mjs",
    "perpl:smoke": "node .github/scripts/perpl-public-smoke.mjs",
    "risk:benchmark": "tsx .github/scripts/risk-benchmark.ts",
    "m03:benchmark": "tsx .github/scripts/m03-policy-benchmark.ts",
    "m04:benchmark": "tsx .github/scripts/m04-permissions-benchmark.ts",
    "sourcepack:validate": "node .github/scripts/validate-source-pack.mjs && node .github/scripts/validate-m05-admission.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:client-bundle": "node .github/scripts/check-client-bundle.mjs",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:check": "drizzle-kit check --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:verify": "node .github/scripts/verify-db-schema.mjs",
    "db:smoke": "npm run db:migrate && npm run db:verify",
    "db:upgrade-smoke": "tsx .github/scripts/migration-from-m02.mjs",
    "smoke:boot": "node .github/scripts/boot-smoke.mjs",
    "gef:verify": "node .github/scripts/verify-gef-bootstrap.mjs state",
    "gef:package:verify": "node .github/scripts/verify-gef-bootstrap.mjs package"
  },
  "devDependencies": {
    "@gef-bootstrap/cli": "1.1.2",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.10.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
