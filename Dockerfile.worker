FROM node:22.23.3-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c

ENV NODE_ENV=production
WORKDIR /app

COPY . .
RUN npm ci --omit=dev --workspace=@nerva/worker --no-audit --no-fund \
    && npm cache clean --force

USER node
CMD ["node", "--experimental-strip-types", "apps/worker/src/main.ts"]
